# ---------------------------------------------------------------------------
# Safari Park Project - Authority Engagement Tracker
# Backend environment configuration
#
# Copy this file to ".env" and fill in real values before deployment.
# Never commit the real .env file to source control.
# ---------------------------------------------------------------------------

# Postgres connection. Either set DATABASE_URL as a single string, or set the
# individual PG* values below. DATABASE_URL takes precedence if present.
DATABASE_URL=postgres://spd_user:CHANGE_ME@localhost:5432/spd_tracker

PGHOST=localhost
PGPORT=5432
PGDATABASE=spd_tracker
PGUSER=spd_user
PGPASSWORD=CHANGE_ME

# Secret used to sign login tokens. Must be a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long a login stays valid.
JWT_EXPIRES_IN=12h

# Port the API server listens on.
PORT=4000

# Absolute or relative path where uploaded documents are stored on disk.
UPLOAD_DIR=./uploads

# Largest single upload allowed, in megabytes.
MAX_UPLOAD_MB=25

# Public origin of the front end, used for CORS. In single-server deployment
# (the API also serves the built front end) this can be left as-is.
CORS_ORIGIN=*
