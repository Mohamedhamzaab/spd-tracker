# ---------------------------------------------------------------------------
# Safari Park Project - Authority Engagement Tracker
# Backend environment configuration
#
# Copy this file to ".env" and fill in real values before deployment.
# Never commit the real .env file to source control.
# ---------------------------------------------------------------------------

# Postgres connection. Either set DATABASE_URL as a single string, or set the
# individual PG* values below. DATABASE_URL takes precedence if present.
DATABASE_URL=postgres://spd_user:CHANGE_ME@localhost:5432/spd_tracker

PGHOST=localhost
PGPORT=5432
PGDATABASE=spd_tracker
PGUSER=spd_user
PGPASSWORD=CHANGE_ME

# Secret used to sign login tokens. Must be a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# How long a login stays valid.
JWT_EXPIRES_IN=12h

# Port the API server listens on.
PORT=4000

# Absolute or relative path where uploaded documents are stored on disk.
UPLOAD_DIR=./uploads

# Largest single upload allowed, in megabytes.
MAX_UPLOAD_MB=25

# Public origin of the front end, used for CORS. In single-server deployment
# (the API also serves the built front end) this can be left as-is.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Outbound mail (nodemailer over SMTP). Used for account invitations and
# password reset links. When these are unset in dev, outgoing mail is logged
# to the backend console so the flow still works end-to-end. In production
# every SMTP_ variable plus APP_URL must be set.
#
# Examples (Gmail app password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.account@gmail.com
#   SMTP_PASS=app-password-from-google
#
# Examples (Mailtrap for staging):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SPD Tracker <no-reply@ecgportal.dev>

# Public URL of the front end. Used to build invite and reset links inside
# outgoing emails. In dev this is the Vite server; in prod it is the deployed
# site. No trailing slash.
APP_URL=http://localhost:5173

# Encryption key for at-rest TOTP secrets (MFA). 32 raw bytes, base64-encoded.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENC_KEY=

# Where `npm run backup` writes pg_dump output. Defaults to ./backups/
# relative to the backend folder. Use an off-platform mount for real backups.
BACKUP_DIR=./backups

# ---------------------------------------------------------------------------
# Document storage. "disk" (default) writes files into UPLOAD_DIR — fine for
# local dev, NOT fine on Render's ephemeral disk where uploads are wiped on
# every redeploy. "s3" uses any S3-compatible object store: AWS S3,
# Cloudflare R2, MinIO, Backblaze B2, Wasabi, …
#
# Examples
#   Cloudflare R2:
#     STORAGE_BACKEND=s3
#     S3_BUCKET=spd-tracker-prod
#     S3_REGION=auto
#     S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#     S3_ACCESS_KEY_ID=...
#     S3_SECRET_ACCESS_KEY=...
#
#   AWS S3:
#     STORAGE_BACKEND=s3
#     S3_BUCKET=spd-tracker-prod
#     S3_REGION=eu-west-1
#     S3_ACCESS_KEY_ID=...   (or rely on IAM role + leave creds blank)
#     S3_SECRET_ACCESS_KEY=...
#
#   MinIO:
#     STORAGE_BACKEND=s3
#     S3_BUCKET=spd-tracker
#     S3_REGION=us-east-1
#     S3_ENDPOINT=http://minio:9000
#     S3_FORCE_PATH_STYLE=true
#     S3_ACCESS_KEY_ID=...
#     S3_SECRET_ACCESS_KEY=...
#
# After flipping the backend to s3 on an existing deployment, run
#   npm run migrate-uploads
# once to copy every existing disk-backed file into the bucket.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=disk
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=documents/

# ---------------------------------------------------------------------------
# Weekly digest. Set DIGEST_ENABLED=true to start the cron scheduler that
# emails every active user a summary every Monday at 08:00 server time.
# Override the cron expression via DIGEST_CRON if you want a different cadence.
# Defaults to "0 8 * * 1".
# ---------------------------------------------------------------------------
DIGEST_ENABLED=false
DIGEST_CRON=0 8 * * 1

# ---------------------------------------------------------------------------
# Structured logging (pino). LOG_LEVEL = debug | info | warn | error.
# LOG_FORMAT = json forces JSON output even in dev (pretty-print is the
# default in dev only).
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=

# ---------------------------------------------------------------------------
# Sentry. Leave SENTRY_DSN unset to disable error reporting completely.
# When set, every uncaught 5xx is reported with the actor user (id, email,
# role) and request context (method, path, IP) attached.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENV=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
